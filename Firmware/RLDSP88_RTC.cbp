<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="RLDSP88_RTC" />
		<Option pch_mode="2" />
		<Option compiler="avr-gcc" />
		<Build>
			<Target title="Debug">
				<Option output="Binarios/RLDSP88_RTC.elf" prefix_auto="1" extension_auto="0" />
				<Option working_dir="" />
				<Option object_output="Binarios/" />
				<Option type="5" />
				<Option compiler="avr-gcc" />
				<Compiler>
					<Add option="-g" />
				</Compiler>
				<Linker>
					<Add option="-mmcu=atmega88p" />
					<Add option="-Wl,--section-start=.assinatura=0x1800" />
					<Add option="-Os" />
				</Linker>
			</Target>
			<Environment>
				<Variable name="MCU" value="atmega88p" />
			</Environment>
		</Build>
		<Compiler>
			<Add option="-Os" />
			<Add option="-Wall" />
			<Add option="-mmcu=atmega88p" />
		</Compiler>
		<ExtraCommands>
			<Add after="avr-objcopy -R .eeprom -R .fuse -R .lock -R .signature -O ihex $(TARGET_OUTPUT_FILE) $(TARGET_OUTPUT_DIR)$(TARGET_OUTPUT_BASENAME).hex" />
			<Add after="avr-objcopy --no-change-warnings -j .eeprom --change-section-lma .eeprom=0 -O ihex $(TARGET_OUTPUT_FILE) $(TARGET_OUTPUT_DIR)$(TARGET_OUTPUT_BASENAME).eep" />
			<Add after="avr-objcopy -R .eeprom -R .fuse -R .lock -R .signature -O binary $(TARGET_OUTPUT_FILE) $(TARGET_OUTPUT_DIR)$(TARGET_OUTPUT_BASENAME).bin" />
			<Add after="avr-objcopy --no-change-warnings -j .eeprom --change-section-lma .eeprom=0 -O binary $(TARGET_OUTPUT_FILE) $(TARGET_OUTPUT_DIR)$(TARGET_OUTPUT_BASENAME).eep" />
		</ExtraCommands>
		<Unit filename="Mod_Def.h" />
		<Unit filename="Mod_Driver.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="Mod_RTC.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="Mod_Timer.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="RLDSP_88_RTC.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="soft_serial.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="soft_serial.h" />
		<Extensions>
			<DoxyBlocks>
				<comment_style block="4" line="0" />
				<doxyfile_project />
				<doxyfile_build />
				<doxyfile_warnings />
				<doxyfile_output />
				<doxyfile_dot />
				<general />
			</DoxyBlocks>
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
